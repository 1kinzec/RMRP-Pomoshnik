name: Build RMRP Помощник for Windows

on:
  workflow_dispatch:
  push:
    tags:
      - 'v*'

permissions:
  contents: read

jobs:
  build:
    name: Windows Release v1.4.0
    runs-on: windows-latest

    steps:
      - name: Получить исходники
        uses: actions/checkout@v5

      - name: Установить Python 3.12 x64
        uses: actions/setup-python@v6
        with:
          python-version: '3.12'
          architecture: x64

      - name: Установить PyInstaller
        run: python -m pip install --disable-pip-version-check --no-warn-script-location pyinstaller==6.16.0

      - name: Проверить исходник
        shell: powershell
        run: python -m py_compile app/RMRP_Pomoshnik.pyw

      - name: Собрать EXE
        run: python -m PyInstaller --noconfirm --clean --onefile --windowed --name RMRP_Pomoshnik --icon installer/assets/rmrp.ico --add-data "app/assets;assets" app/RMRP_Pomoshnik.pyw

      - name: Установить Inno Setup
        shell: powershell
        run: choco install innosetup --no-progress -y

      - name: Собрать установщик
        shell: powershell
        run: '& "C:\Program Files (x86)\Inno Setup 6\ISCC.exe" installer\RMRP-Pomoshnik.iss'

      - name: Проверить результат
        shell: powershell
        run: |
          if (!(Test-Path "dist\RMRP_Pomoshnik.exe")) { throw "EXE не создан" }
          if (!(Test-Path "installer\output\RMRP-Pomoshnik-Setup-1.4.0.exe")) { throw "Установщик не создан" }

      - name: Загрузить релизные файлы
        uses: actions/upload-artifact@v4
        with:
          name: RMRP-Pomoshnik-Windows-v1.4.0
          if-no-files-found: error
          retention-days: 30
          path: |
            dist/RMRP_Pomoshnik.exe
            installer/output/RMRP-Pomoshnik-Setup-1.4.0.exe
